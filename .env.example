# Copy to .env.local.

# --- Which shop this deployment is ----------------------------------------
# Must match a key in config/brands/. Unset falls back to the default in
# config/index.ts, which is fine on a dev machine and wrong in production.
NEXT_PUBLIC_BRAND=everribbon

# --- Supabase -------------------------------------------------------------
# Public — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. This key BYPASSES row-level security: every row of every table,
# for anyone holding it. It must never be referenced from a client component,
# never be prefixed NEXT_PUBLIC_, and never appear in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# Absolute URL, needed for share cards — a relative image path is ignored by
# Facebook and Messenger, which looks like "the picture doesn't show up".
NEXT_PUBLIC_SITE_URL=
